DATABASE_URL=postgresql://user:password@localhost:5432/smartstock
JWT_SECRET=replace-with-a-local-development-secret
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
N8N_WEBHOOK_URL=https://example.com/webhook/smartstock
# Configure these for real background browser push; keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-team@example.com
# Compose reads these SMARTSTOCK_* values and injects the backend VAPID_* variables.
SMARTSTOCK_VAPID_PUBLIC_KEY=
SMARTSTOCK_VAPID_PRIVATE_KEY=
SMARTSTOCK_VAPID_SUBJECT=mailto:your-team@example.com
PORT=3000
